<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext (http) anywhere; only the system trust store; no user-installed CAs. The app loads nothing remote. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
